{
  "name": "nightcall-backend",
  "version": "1.0.0",
  "description": "NightCall anonymous voice call backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:migrate46": "ts-node src/db/migrate46.ts",
    "db:migrate003": "ts-node -e \"require('./src/db/pool').pool.query(require('fs').readFileSync('./src/db/migrations/003_wall_likes.sql','utf8')).then(()=>{console.log('Done');process.exit(0);}).catch(e=>{console.error(e);process.exit(1);})\""
  },
  "license": "MIT",
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "bad-words": "^3.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^22.1.1",
    "twilio": "^6.0.2",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
