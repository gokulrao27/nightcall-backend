# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=https://night-talks.vercel.app

# PostgreSQL (Railway provides DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/nightcall

# Redis (Railway provides REDIS_URL)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_random_256_bit_secret_at_least_32_chars
JWT_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:nightcall-push@yourdomain.com

# TURN server (use Metered.ca free tier for dev)
TURN_URLS=turn:relay.metered.ca:80
TURN_USERNAME=
TURN_CREDENTIAL=
